appliances = [
    ("AC", 5, 8),
    ("Washing Machine", 3, 4),
    ("Heater", 4, 6),
    ("Dishwasher", 2, 3)
]

budget = 10

n = len(appliances)

dp = [[0] * (budget + 1) for _ in range(n + 1)]

for i in range(1, n + 1):
    energy = appliances[i - 1][1]
    saving = appliances[i - 1][2]

    for j in range(budget + 1):
        if energy <= j:
            dp[i][j] = max(
                dp[i - 1][j],
                dp[i - 1][j - energy] + saving
            )
        else:
            dp[i][j] = dp[i - 1][j]

print("Maximum Energy Saving:", dp[n][budget])
